```{r weight-comparison, message=FALSE, warning=FALSE}
{r weight-comparison, message=FALSE, warning=FALSE}
r weight-comparison, message=FALSE, warning=FALSE
library(tidyverse)
# Boxplot avec points individuels
ggplot(ieap2025, aes(x = Gender, y = Weight, fill = Gender)) +
geom_boxplot(alpha = 0.7) +
geom_jitter(width = 0.1, alpha = 0.5) +
labs(title = "Répartition du poids selon le genre",
x = "Genre",
y = "Poids (kg)") +
scale_fill_manual(values = c("M" = "blue", "F" = "pink")) +
theme_minimal()
# Histogramme superposé
ggplot(ieap2025, aes(x = Weight, fill = Gender)) +
geom_histogram(position = "identity", alpha = 0.5, bins = 15, color = "black") +
labs(title = "Histogramme du poids par genre",
x = "Poids (kg)",
y = "Nombre") +
scale_fill_manual(values = c("M" = "blue", "F" = "pink")) +
theme_minimal()
# Test t pour comparer les poids hommes vs femmes
t_test_result <- t.test(Weight ~ Gender, data = ieap2025)
t_test_result
# Conclusion automatique
if(t_test_result$p.value < 0.05){
cat("Conclusion : Il existe une différence statistiquement significative entre les poids des hommes et des femmes (p =", round(t_test_result$p.value,3), ").\n")
} else {
cat("Conclusion : Il n’existe pas de différence statistiquement significative entre les poids des hommes et des femmes (p =", round(t_test_result$p.value,3), ").\n")
}
```{r weight-comparison, message=FALSE, warning=FALSE}
library(tidyverse)
# Boxplot with individual points
ggplot(ieap2025, aes(x = Gender, y = Weight, fill = Gender)) +
geom_boxplot(alpha = 0.7) +
geom_jitter(width = 0.1, alpha = 0.5) +
labs(title = "Weight Distribution by Gender",
x = "Gender",
y = "Weight (kg)") +
scale_fill_manual(values = c("M" = "blue", "F" = "pink")) +
theme_minimal()
# Overlapping histogram
ggplot(ieap2025, aes(x = Weight, fill = Gender)) +
geom_histogram(position = "identity", alpha = 0.5, bins = 15, color = "black") +
labs(title = "Histogram of Weight by Gender",
x = "Weight (kg)",
y = "Count") +
scale_fill_manual(values = c("M" = "blue", "F" = "pink")) +
theme_minimal()
# t-test comparing male vs female weights
t_test_result <- t.test(Weight ~ Gender, data = ieap2025)
t_test_result
# Automatic conclusion
if(t_test_result$p.value < 0.05){
cat("Conclusion: There is a statistically significant difference between male and female weights (p =", round(t_test_result$p.value,3), ").\n")
} else {
cat("Conclusion: There is no statistically significant difference between male and female weights (p =", round(t_test_result$p.value,3), ").\n")
}
